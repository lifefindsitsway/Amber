      "quotesStraightenedInAss": true,
      "styledAssPrewrap": true
    }
  },
  "expectKeys": {
    "speakers": "where speaker names can be read back: prefix = SRT first-line `名字：`; voice = VTT `<v 名字>`; name = ASS `Name` field; none = no speaker information",
    "translation": "the file carries translation lines (bilingual)",
    "timingPrecisionMs": "precision of the time stamps; null = no timing",
    "overlapRebuilt": "overlapping sentences were cut into non-overlapping slices on export and must be rebuilt from the slices",
    "restoreData": "the file carries Amber restore data (none of these releases wrote any)",
    "backgroundLayer": "layer-0 background-box events (Box*/Line*/Ghost* styles) that must be dropped",
    "speakerLabelRows": "speaker label rows (Speaker* styles) stacked above the text",
    "prewrapped": "lines wider than the wrap width were broken in advance with \\N and must be merged back",
    "textIsTranslation": "the exported revision was the translation itself, drawn in the Translation style",
    "quotesStraightened": "curly quotes and apostrophes were written as straight ones",
    "referenceTextOnly": "no timeline; imports only as reference text"
  },
