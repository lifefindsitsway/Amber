{
  "name": "amber",
  "version": "0.3.0-rc.4",
  "private": true,
  "description": "Amber: An open-source AI-powered audio & video processing tool that supports transcription, subtitle proofreading, summarization, translation, and more.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit --project web",
    "test:file": "node src/tooling/test-file.ts",
    "test:guards": "vitest run --project guards",
    "test:e2e": "vite build && playwright test",
    "dev": "node src/tooling/dev.ts",
    "build": "vite build && node src/tooling/build-server.ts && node src/tooling/export-desktop-defaults.ts && node src/tooling/export-installer-hooks.ts && node src/tooling/export-installer-template.ts",
    "pack:sidecar": "node src/tooling/pack-sidecar.ts",
    "check:versions": "node src/tooling/check-versions.ts",
    "setup:tools": "node src/tooling/setup-tools.ts",
    "tauri": "tauri",
    "sync:mirror": "node src/tooling/sync-mirror.ts",
    "verify:mirror": "node src/tooling/verify-mirror.ts",
    "updater:config": "node src/tooling/updater-config.ts",
    "release:manifest": "node src/tooling/release-manifest.ts",
    "build:report": "node src/tooling/build-report.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "hash-wasm": "4.12.0",
    "tar": "7.5.22",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/cli": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-notification": "2.5.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cmdk": "1.1.1",
    "esbuild": "0.28.2",
    "i18next": "26.4.2",
    "jsdom": "29.1.1",
    "lucide-react": "1.49.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
